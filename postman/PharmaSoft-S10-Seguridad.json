{
  "info": {
    "name": "PharmaSoft - S10 Seguridad",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "28 casos de la matriz S10. Use solo un entorno local de desarrollo. Los casos B alteran usuarios demo; restaurar al final."
  },
  "item": [
    {
      "name": "A - Autenticación",
      "item": [
        {
          "name": "A-01 - Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "A-01: HTTP esperado 200. Ejecutar los grupos en orden.",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin\", \"password\": \"{{demoPassword}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"A-01: HTTP 200\", () => pm.response.to.have.status(200));",
                  "if(pm.response.code===200) pm.collectionVariables.set(\"adminToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
